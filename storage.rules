rules_version = '2';

// ProjexiaHub Cloud Storage security rules.
//
// These mirror ATTACHMENT_RULES and PROJECT_IMAGE_RULES in
// src/constants/requestOptions.ts. The constants give fast feedback in the
// browser; these rules are what actually enforce the limits.

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isAllowedAttachment() {
      return request.resource.contentType.matches(
        'image/(jpeg|png|webp|gif)|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document|text/plain'
      );
    }

    function isUnderSizeLimit() {
      return request.resource.size <= 5 * 1024 * 1024; // 5 MB
    }

    // -----------------------------------------------------------------------
    // Project media — projects/{projectId}/thumbnail|gallery|videos/{file}
    // -----------------------------------------------------------------------
    match /projects/{projectId}/{folder}/{fileName} {
      // Public: project images appear on the public site, so they must be readable.
      allow read: if true;

      allow write: if isAdmin() && isImage() && isUnderSizeLimit();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // Request attachments — projectRequests/{requestId}/attachments/{file}
    // -----------------------------------------------------------------------
    match /projectRequests/{requestId}/attachments/{fileName} {
      // Not public. Attachments can contain private drawings or specifications,
      // so only an admin can read them back.
      allow read: if isAdmin();

      // Anyone may upload as part of submitting a request, but only a new
      // object: `resource == null` means overwriting an existing attachment is
      // refused, so one submitter cannot replace another's file.
      allow create: if resource == null
        && isAllowedAttachment()
        && isUnderSizeLimit();

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
