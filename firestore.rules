rules_version = '2';

// ProjexiaHub Firestore security rules.
//
// Principle: the browser bundle is public and can be modified by anyone, so
// nothing in the React app is a security control. These rules are the only real
// boundary. Assume every request is hostile and allow the narrowest thing that
// makes the site work.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    // Admin access is granted by the EXISTENCE of a document at admins/{uid}.
    // Deliberately not an email comparison: emails can be changed by the user
    // on their own account, and a hardcoded address cannot be revoked without
    // a redeploy.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || isString(value, maxLength);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return isSignedIn() && data.ownerUid == request.auth.uid;
    }

    // The username -> sign-in email mapping is not public. Only the dedicated
    // "resolver" account used by the image-upload/auth Worker may read it.
    // That account is registered by creating a document at resolvers/{uid} in
    // the Firebase Console (same pattern as admins/{uid}); it is never
    // writable from a client.
    function isResolver() {
      return request.auth != null
        && exists(/databases/$(database)/documents/resolvers/$(request.auth.uid));
    }

    // A public status record may only be created for a request the caller owns,
    // under that request's own number. getAfter() sees the request whether it
    // was written earlier or in the same batch.
    function ownsLookupTarget(requestNumber) {
      let requestPath = /databases/$(database)/documents/projectRequests/$(request.resource.data.requestId);
      return existsAfter(requestPath)
        && getAfter(requestPath).data.ownerUid == request.auth.uid
        && getAfter(requestPath).data.requestNumber == requestNumber;
    }

    function customerEditWindowOpen() {
      let settingsPath = /databases/$(database)/documents/settings/requestSecurity;
      let hours = exists(settingsPath)
        ? get(settingsPath).data.get('customerRequestEditWindowHours', 24)
        : 24;
      return resource.data.createdAt is timestamp
        && hours is int
        && hours >= 1
        && hours <= 720
        && request.time < resource.data.createdAt + duration.value(hours, 'h');
    }

    // ---------------------------------------------------------------------
    // projects
    // ---------------------------------------------------------------------
    match /projects/{projectId} {

      // Anyone may read a published project. Drafts are admin-only, which is
      // what makes "unpublish" actually hide something.
      allow get, list: if resource.data.published == true || isAdmin();

      allow create, delete: if isAdmin();

      // Two separate update paths:
      //  1. An admin may change anything.
      //  2. The public may increment viewCount and nothing else. Without this,
      //     the view counter on the project page would silently fail forever.
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount is int
          && request.resource.data.viewCount == resource.data.viewCount + 1
        );
    }

    // ---------------------------------------------------------------------
    // School model catalog: published items are public, drafts are admin-only.
    match /schoolModels/{modelId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.published == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount is int
          && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1);
    }

    // ---------------------------------------------------------------------
    // Collections gallery: published items are public; drafts and all writes
    // remain restricted to authenticated administrators.
    match /collections/{itemId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // projectRequests
    // ---------------------------------------------------------------------
    match /projectRequests/{requestId} {

      // Full requests are private. Admins can manage all requests; customers
      // can only read their own authenticated requests.
      //
      // Because the owner can read this whole document, it must never contain
      // anything the customer should not see. Internal notes, the quoted price
      // and the assignee live in requestPrivate/{requestId} instead.
      allow read: if isAdmin() || isOwner(resource.data);

      // Every new customer request must belong to the authenticated account
      // that submitted it. This is enforced here, not just in React.
      allow create: if isValidNewRequest();

      // Admins may manage requests, including moving an active request to
      // trash during the configured protection period. The React admin UI
      // requires the per-request project token before it performs that action.
      // The token is an administrative workflow safeguard; Firebase rules
      // remain the authoritative admin authentication boundary.
      allow update: if isAdmin()
        || (
          isOwner(resource.data)
          && customerEditWindowOpen()
          && request.resource.data.get('deletedAt', null) == null
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.requestNumber == resource.data.requestNumber
          && request.resource.data.status == resource.data.status
          && request.resource.data.priority == resource.data.priority
          && request.resource.data.customerUpdate == resource.data.customerUpdate
          && request.resource.data.customerUpdateAt == resource.data.customerUpdateAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'contact',
            'project',
            'technical',
            'software',
            'scale',
            'budget',
            'timeline',
            'references',
            'attachments',
            'additionalRequirements',
            'updatedAt'
          ])
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() <= 5
          && request.resource.data.attachments.size() >= resource.data.attachments.size()
          && request.resource.data.attachments.hasAll(resource.data.attachments)
        )
        || (
          isOwner(resource.data)
          && resource.data.get('deletedAt', null) == null
          && customerEditWindowOpen()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.requestNumber == resource.data.requestNumber
          && request.resource.data.status == resource.data.status
          && request.resource.data.priority == resource.data.priority
          && request.resource.data.customerUpdate == resource.data.customerUpdate
          && request.resource.data.customerUpdateAt == resource.data.customerUpdateAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.deletedAt == request.time
          && request.resource.data.deletedBy == 'customer'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deletedAt',
            'deletedBy',
            'updatedAt'
          ])
        );

      // Customers may permanently delete only their own already-deleted
      // requests. Admins may permanently delete any request only after it is
      // already in trash; active requests cannot be hard-deleted.
      allow delete: if (
        isAdmin()
        && resource.data.get('deletedAt', null) != null
      ) || (
        isOwner(resource.data)
        && resource.data.deletedAt != null
        && resource.data.deletedBy == 'customer'
      );

      // Every key a legitimate client writes is listed here, for the document
      // and for each nested map, so a request cannot be used to store arbitrary
      // extra data. If a form gains a field, add it here too.
      function isValidNewRequest() {
        let incoming = request.resource.data;
        return
          request.auth != null
          && incoming.keys().hasOnly([
            'requestNumber', 'projectToken', 'ownerUid', 'status', 'priority',
            'serviceType', 'schoolModel', 'contact', 'project', 'technical',
            'software', 'scale', 'budget', 'timeline', 'references',
            'attachments', 'additionalRequirements', 'consent',
            'customerUpdate', 'customerUpdateAt', 'metadata',
            'createdAt', 'updatedAt'
          ])
          && incoming.keys().hasAll([
            'requestNumber', 'ownerUid', 'status', 'priority', 'contact',
            'project', 'consent', 'attachments', 'createdAt', 'updatedAt'
          ])
          && incoming.ownerUid == request.auth.uid

          // The workflow always begins at 'new'. A spammer cannot inject a
          // request that already looks reviewed or accepted.
          && incoming.status == 'new'
          && incoming.priority in ['low', 'normal', 'high', 'urgent']
          && incoming.get('serviceType', 'electronics') in ['electronics', 'school-model']

          // Consent is a legal requirement, not a UI nicety, so it is enforced here.
          && incoming.consent.keys().hasOnly(['agreeToTerms', 'allowContact'])
          && incoming.consent.agreeToTerms == true
          && incoming.consent.allowContact == true

          // The customer-facing update is written by admins only. There is no
          // admin block on this document at all: see requestPrivate below.
          && incoming.get('customerUpdate', null) == null
          && incoming.get('customerUpdateAt', null) == null

          // Timestamps must come from the server, never from the client clock.
          && incoming.createdAt == request.time
          && incoming.updatedAt == request.time

          && isString(incoming.requestNumber, 40)
          && isOptionalString(incoming.get('projectToken', null), 40)
          && isString(incoming.ownerUid, 128)

          && incoming.contact.keys().hasOnly([
            'fullName', 'email', 'phone', 'whatsapp', 'country', 'city',
            'preferredContactMethod'
          ])
          && isString(incoming.contact.fullName, 100)
          && isString(incoming.contact.email, 200)
          && incoming.contact.email.matches('.+@.+[.].+')
          && isOptionalString(incoming.contact.get('phone', null), 30)
          && isOptionalString(incoming.contact.get('whatsapp', null), 30)
          && isOptionalString(incoming.contact.get('country', null), 200)
          && isOptionalString(incoming.contact.get('city', null), 200)
          && isOptionalString(incoming.contact.get('preferredContactMethod', null), 500)

          && incoming.project.keys().hasOnly([
            'title', 'category', 'type', 'purpose', 'description'
          ])
          && isString(incoming.project.title, 120)
          && isString(incoming.project.description, 10000)
          && isString(incoming.project.category, 60)
          && isOptionalString(incoming.project.get('type', null), 500)
          && isOptionalString(incoming.project.get('purpose', null), 10000)

          && (!('schoolModel' in incoming)
            || incoming.schoolModel.keys().hasOnly([
              'itemId', 'slug', 'category', 'modelFormat', 'interaction'
            ]))

          && (!('technical' in incoming)
            || (
              incoming.technical.keys().hasOnly([
                'preferredPlatforms', 'connectivity', 'sensors', 'outputs',
                'powerSource', 'powerRequirements'
              ])
              && incoming.technical.get('preferredPlatforms', []).size() <= 50
              && incoming.technical.get('connectivity', []).size() <= 50
              && incoming.technical.get('sensors', []).size() <= 50
              && incoming.technical.get('outputs', []).size() <= 50
              && isOptionalString(incoming.technical.get('powerSource', null), 500)
              && isOptionalString(incoming.technical.get('powerRequirements', null), 10000)
            ))

          && (!('software' in incoming)
            || (
              incoming.software.keys().hasOnly([
                'requiresMobileApp', 'requiresWebDashboard',
                'requiresCloudDatabase', 'requiresNotifications',
                'requiresRemoteControl', 'notes', 'languages'
              ])
              && incoming.software.get('languages', []).size() <= 50
              && isOptionalString(incoming.software.get('notes', null), 10000)
            ))

          && (!('scale' in incoming)
            || (
              incoming.scale.keys().hasOnly([
                'complexity', 'prototypeQuantity', 'estimatedQuantity',
                'deploymentEnvironment'
              ])
              && isOptionalString(incoming.scale.get('complexity', null), 500)
              && isOptionalString(incoming.scale.get('deploymentEnvironment', null), 10000)
            ))

          && (!('budget' in incoming)
            || (
              incoming.budget.keys().hasOnly(['range', 'notes'])
              && isOptionalString(incoming.budget.get('range', null), 500)
              && isOptionalString(incoming.budget.get('notes', null), 10000)
            ))

          && (!('timeline' in incoming)
            || (
              incoming.timeline.keys().hasOnly([
                'desiredStartDate', 'desiredDeadline', 'flexibility', 'urgency'
              ])
              && isOptionalString(incoming.timeline.get('flexibility', null), 500)
              && isOptionalString(incoming.timeline.get('urgency', null), 500)
            ))

          && (!('references' in incoming)
            || (
              incoming.references.keys().hasOnly(['links', 'description'])
              && incoming.references.get('links', []).size() <= 20
              && isOptionalString(incoming.references.get('description', null), 10000)
            ))

          && (!('additionalRequirements' in incoming)
            || (
              incoming.additionalRequirements.keys().hasOnly([
                'specialRequirements', 'additionalNotes', 'consultationRequired',
                'hasExistingHardware', 'existingHardwareDescription',
                'hasExistingCode', 'existingCodeDescription'
              ])
              && isOptionalString(incoming.additionalRequirements.get('specialRequirements', null), 10000)
              && isOptionalString(incoming.additionalRequirements.get('additionalNotes', null), 10000)
              && isOptionalString(incoming.additionalRequirements.get('existingHardwareDescription', null), 10000)
              && isOptionalString(incoming.additionalRequirements.get('existingCodeDescription', null), 10000)
            ))

          && (!('metadata' in incoming)
            || (
              incoming.metadata.keys().hasOnly(['source', 'userAgent', 'createdFrom'])
              && isOptionalString(incoming.metadata.get('source', null), 100)
              && isOptionalString(incoming.metadata.get('userAgent', null), 400)
              && isOptionalString(incoming.metadata.get('createdFrom', null), 100)
            ))

          // Attachments are metadata only; the files themselves are hosted by
          // the image-upload Worker (ImgBB). Rules cannot inspect list items,
          // so the client refuses to render anything but http(s) URLs.
          && incoming.attachments is list
          && incoming.attachments.size() <= 5;
      }
    }

    // ---------------------------------------------------------------------
    // requestPrivate — admin-only data for a request: internal notes, quoted
    // price, assignee. Keyed by the request's document id.
    //
    // This is deliberately NOT a field on projectRequests: the customer who
    // owns a request may read that whole document, including the network
    // response, whatever the UI chooses to render.
    // ---------------------------------------------------------------------
    match /requestPrivate/{requestId} {
      allow read: if isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'notes', 'quotedAmount', 'currency', 'assignedTo', 'updatedAt'
        ])
        && isOptionalString(request.resource.data.get('notes', null), 20000)
        && (request.resource.data.get('quotedAmount', null) == null
          || request.resource.data.quotedAmount is number)
        && isOptionalString(request.resource.data.get('currency', null), 10)
        && isOptionalString(request.resource.data.get('assignedTo', null), 200);

      // Admins may delete freely. A customer may remove this record only in
      // the same batch that permanently deletes their own, already-trashed
      // request, so erasing a request does not leave internal notes behind.
      // They still cannot read it.
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/projectRequests/$(requestId))
          && get(/databases/$(database)/documents/projectRequests/$(requestId)).data.ownerUid == request.auth.uid
          && get(/databases/$(database)/documents/projectRequests/$(requestId)).data.get('deletedBy', null) == 'customer'
          && !existsAfter(/databases/$(database)/documents/projectRequests/$(requestId))
        );
    }

    // ---------------------------------------------------------------------
    // meetingRequests
    // ---------------------------------------------------------------------
    match /meetingRequests/{meetingId} {
      // Meeting requests require a signed-in customer account. All reading
      // and management stays in the admin area.
      allow create: if
        request.auth != null
        && request.resource.data.keys().hasOnly([
          'fullName','email','phone','whatsapp','country','city','purpose',
          'preferredDate','preferredTime','timezone','duration','method',
          'discussion','projectReference','additionalNotes','status','adminNotes',
          'confirmedDate','confirmedTime','meetingLink','createdAt','updatedAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isString(request.resource.data.fullName, 100)
        && isString(request.resource.data.email, 200)
        && request.resource.data.email.matches('.+@.+[.].+')
        && isOptionalString(request.resource.data.phone, 30)
        && isOptionalString(request.resource.data.whatsapp, 30)
        && isOptionalString(request.resource.data.country, 80)
        && isOptionalString(request.resource.data.city, 80)
        && request.resource.data.purpose in [
          'Project consultation',
          'Discuss an existing project request',
          'Technical discussion',
          'General inquiry'
        ]
        && isString(request.resource.data.preferredDate, 20)
        && isString(request.resource.data.preferredTime, 10)
        && isString(request.resource.data.timezone, 80)
        && request.resource.data.duration in ['15 minutes', '30 minutes', '60 minutes']
        && request.resource.data.method in ['Google Meet', 'WhatsApp', 'Phone call', 'Face-to-face']
        && isString(request.resource.data.discussion, 3000)
        && isOptionalString(request.resource.data.projectReference, 80)
        && isOptionalString(request.resource.data.additionalNotes, 2000)
        && request.resource.data.adminNotes == null
        && request.resource.data.confirmedDate == null
        && request.resource.data.confirmedTime == null
        && request.resource.data.meetingLink == null;

      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // settings/requestSecurity — public read is limited to a non-sensitive
    // customer edit-window value; only admins can change it.
    // ---------------------------------------------------------------------
    match /settings/requestSecurity {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin()
        && request.resource.data.customerRequestEditWindowHours is int
        && request.resource.data.customerRequestEditWindowHours >= 1
        && request.resource.data.customerRequestEditWindowHours <= 720;
    }

    // ---------------------------------------------------------------------
    // settings/emailNotificationsPublic — browser-safe EmailJS configuration.
    // EmailJS client-side sending requires the service/template/public key.
    // The recipient is MECTEC's public business email, not customer data.
    // No request content, admin notes, credentials, or private account data
    // belongs in this document.
    // ---------------------------------------------------------------------
    match /settings/emailNotificationsPublic {
      allow get: if true;
      allow list: if false;

      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'serviceId',
          'templateId',
          'publicKey',
          'toEmail',
          'updatedAt'
        ])
        && request.resource.data.serviceId is string
        && request.resource.data.templateId is string
        && request.resource.data.publicKey is string
        && request.resource.data.toEmail is string;
    }

    // ---------------------------------------------------------------------
    // requestStatusLookup — the public "track my request" page reads only
    // this narrow record, never the full projectRequests document, so an
    // admin's internal notes and quoted amounts can never reach a visitor's
    // browser, even via the network tab.
    // ---------------------------------------------------------------------
    match /requestStatusLookup/{requestNumber} {
      // Doc id = requestNumber (10 random characters, ~8e14 values), so a
      // `get` here already requires knowing that unguessable value. There is
      // no `list`, so the collection can never be enumerated.
      allow get: if true;
      allow list: if false;

      // Written once, right after the real request, by the signed-in customer
      // who owns that request (see ownsLookupTarget). The public record holds
      // a hash of the email, never the address itself.
      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.resource.data.keys().hasOnly([
            'requestNumber', 'requestId', 'status', 'projectTitle',
            'emailHash', 'createdAt', 'updatedAt', 'customerUpdate',
            'customerUpdateAt', 'deletedAt'
          ])
          && request.resource.data.requestNumber == requestNumber
          && request.resource.data.requestId is string
          && request.resource.data.status == 'new'
          && isString(request.resource.data.projectTitle, 120)
          && request.resource.data.emailHash is string
          && request.resource.data.emailHash.size() == 64
          && request.resource.data.get('customerUpdate', null) == null
          && request.resource.data.get('customerUpdateAt', null) == null
          && request.resource.data.get('deletedAt', null) == null
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && ownsLookupTarget(requestNumber)
        );

      // Admins can maintain status/trash state. A customer may only mark
      // their own request as trashed; the rule resolves the real request by
      // requestId instead of exposing ownerUid in this public document.
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'updatedAt'])
          && request.resource.data.deletedAt == request.time
          && resource.data.requestId is string
          && exists(/databases/$(database)/documents/projectRequests/$(resource.data.requestId))
          && get(/databases/$(database)/documents/projectRequests/$(resource.data.requestId)).data.ownerUid == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // contactMessages
    // ---------------------------------------------------------------------
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();

      // Anonymous by design (the contact form needs no account), so this is the
      // easiest write to spam. The field allowlist and length caps bound the
      // damage; enable Firebase App Check to bound the volume (see README).
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'subject', 'message', 'read', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'email', 'subject', 'message', 'read', 'createdAt'
        ])
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time
        && isString(request.resource.data.name, 100)
        && isString(request.resource.data.email, 200)
        && request.resource.data.email.matches('.+@.+[.].+')
        && isString(request.resource.data.subject, 150)
        && isString(request.resource.data.message, 3000);
    }

    // ---------------------------------------------------------------------
    // admins
    // ---------------------------------------------------------------------
    match /admins/{uid} {
      // A signed-in user may read ONLY their own admin document. This is what
      // authService.isAdmin() calls to decide whether to show the dashboard.
      // Listing the collection is not permitted, so the set of admins is not
      // enumerable by anyone.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      // Never writable from the client. Add and remove admins in the Firebase
      // Console — see README, "Creating an admin account".
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // usernameLookup — exact username -> Firebase Auth email mapping.
    //
    // The sign-in email is personal data, so this document is NOT public.
    // Username sign-in goes through the Worker's /auth/login route, which reads
    // it with the resolver account and only reveals the email after the
    // password has been verified. Customers can still create and refresh their
    // own record; nobody else can read it.
    // ---------------------------------------------------------------------
    match /usernameLookup/{username} {
      allow get: if isResolver();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'authEmail', 'createdAt'])
        && !exists(/databases/$(database)/documents/usernameLookup/$(username));
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'authEmail', 'createdAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // resolvers — marks the Firebase Auth account the Worker signs in as to
    // read usernameLookup. Managed in the Firebase Console only.
    // ---------------------------------------------------------------------
    match /resolvers/{uid} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // users — private customer profile documents.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.recoveryEmail is string
        && request.resource.data.recoveryEmail.matches('.+@.+[.].+')
        && request.resource.data.keys().hasOnly([
          'uid',
          'username',
          'recoveryEmail',
          'createdAt',
          'updatedAt'
        ]);
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recoveryEmail', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // imageHostingAssets — public fallback URLs only; no provider keys or delete URLs.
    match /imageHostingAssets/{assetId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // settings/imageHosting contains only the public Worker URL and provider preference.
    match /settings/imageHosting {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // settings — site-wide config, e.g. settings/banner
    // ---------------------------------------------------------------------
    match /settings/{docId} {
      // Only explicitly public settings may be read by visitors. In particular,
      // EmailJS and imgBB overrides must never be exposed through Firestore.
      allow get: if isAdmin() || docId in ['banner', 'theme', 'requestSecurity', 'siteProfile', 'schoolModels', 'collections', 'requestStatusMessages'];
      allow list: if false;

      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // posts — blog / build-log entries
    // ---------------------------------------------------------------------
    match /posts/{postId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // testimonials
    // ---------------------------------------------------------------------
    match /testimonials/{testimonialId} {
      allow get, list: if resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // projectLibrary — reusable admin-managed project form options
    // ---------------------------------------------------------------------
    match /projectLibrary/{itemId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'kind', 'category', 'description', 'unit', 'defaultValue',
          'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.kind in [
          'component', 'specification', 'tag', 'feature', 'technology', 'tool',
          'objective', 'challenge', 'category', 'subcategory', 'protocol', 'application', 'difficulty', 'status'
        ]
        // Project library entries can include detailed formatted text.
        // Keep a generous per-entry ceiling while respecting Firestore's
        // overall 1 MiB document-size limit.
        && request.resource.data.name.size() <= 10000
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.unit is string
        && request.resource.data.defaultValue is string
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // Anything not matched above is denied. No catch-all rule by design.
  }
}
