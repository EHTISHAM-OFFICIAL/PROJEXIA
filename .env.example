# Copy this file to .env and fill in the values from:
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration
#
# These values are NOT secrets. They ship in the browser bundle by design.
# Real security is enforced by firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (optional but recommended). reCAPTCHA v3 site key from the
# Firebase Console > App Check. Leave blank to keep App Check off.
VITE_RECAPTCHA_SITE_KEY=

# Image-host API keys are private Cloudflare Worker secrets. Do not add them to VITE_ variables.

# EmailJS (https://www.emailjs.com/) — optional, for email notifications on
# new requests/messages. Leave blank to skip this feature entirely; nothing
# else breaks. Can also be set/overridden from Admin -> Settings.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TO_EMAIL=
