# Copy this file to .env and fill in the values from:
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration
#
# These values are NOT secrets. They ship in the browser bundle by design.
# Real security is enforced by firestore.rules and storage.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# imgBB (https://api.imgbb.com/) — used for all image hosting instead of
# Firebase Storage, since Storage now requires the paid Blaze plan even for
# free-tier usage. Get a free key at https://api.imgbb.com/.
# Can also be set/overridden later from Admin -> Settings without a redeploy.
VITE_IMGBB_API_KEY=

# EmailJS (https://www.emailjs.com/) — optional, for email notifications on
# new requests/messages. Leave blank to skip this feature entirely; nothing
# else breaks. Can also be set/overridden from Admin -> Settings.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TO_EMAIL=
